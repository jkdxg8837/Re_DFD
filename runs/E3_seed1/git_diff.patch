@@ -0,0 +1,42 @@
+#!/bin/bash
+# Launch one experiment run with the bookkeeping required by spec §0 rule 4.
+#   runs/<EXP_ID>/cmd.sh           exact command
+#   runs/<EXP_ID>/git_diff.patch   code changes vs. the original DFD commit (tracked diff + untracked files)
+#   runs/<EXP_ID>/train.log        full log
+#   runs/<EXP_ID>/config_dump.yaml effective config (copied from the FastGen save path after startup)
+#   runs/<EXP_ID>/load_report.json per-submodule load report (scripts/train_dfd.py)
+# Usage (inside a Slurm allocation, from the repo root): scripts/launch_run.sh <EXP_ID> <NGPU> <override> [...]
+set -uo pipefail
+EXP_ID=$1
+NGPU=$2
+shift 2
+REPO=/gpfs/home/j/jiayang_gu/workspace/data-forcing-distillation
+cd $REPO
+source .venv/bin/activate
+export WANDB_MODE=offline
+BASE_COMMIT=de6416c
+D=runs/$EXP_ID
+mkdir -p $D
+{
+  echo "#!/bin/bash"
+  echo "# $(date -Is) on $(hostname), SLURM_JOB_ID=${SLURM_JOB_ID:-none}"
+  printf 'cd %q && source .venv/bin/activate && WANDB_MODE=offline torchrun --nproc_per_node=%s --standalone scripts/train_dfd.py --config fastgen/configs/experiments/WanT2V/config_dmd2.py -' "$REPO" "$NGPU"
+  for o in "$@"; do printf ' %q' "$o"; done
+  echo
+} > $D/cmd.sh
+{
+  echo "# base commit: $BASE_COMMIT ($(git log -1 --format=%s $BASE_COMMIT))"
+  echo "# HEAD: $(git rev-parse --short HEAD)"
+  git diff $BASE_COMMIT
+  for f in $(git ls-files --others --exclude-standard -- fastgen scripts tests train.py); do
+    git diff --no-index /dev/null "$f"
+  done
+} > $D/git_diff.patch
+echo "[launch_run] $EXP_ID: $(tail -1 $D/cmd.sh)"
+torchrun --nproc_per_node=$NGPU --standalone scripts/train_dfd.py \
+  --config fastgen/configs/experiments/WanT2V/config_dmd2.py - "$@" > $D/train.log 2>&1
+rc=$?
+CFG=$(ls -t FASTGEN_OUTPUT/*/*/"$(grep -oE 'log_config.name=[^ ]+' $D/cmd.sh | head -1 | cut -d= -f2)"/config.yaml 2>/dev/null | head -1)
+[ -n "$CFG" ] && cp "$CFG" $D/config_dump.yaml && cp "$(dirname "$CFG")/load_report.json" $D/ 2>/dev/null
+echo "[launch_run] $EXP_ID finished with exit code $rc (config: ${CFG:-not found})"
+exit $rc
diff --git a/scripts/probe_frames.py b/scripts/probe_frames.py
new file mode 100644
index 0000000..5875f71
--- /dev/null
+++ b/scripts/probe_frames.py
@@ -0,0 +1,189 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Memory probe for the latent frame count T (spec §2.5 of `Dfd experiments.md`).
+
+Driver mode (default) walks the frame ladder from the largest T down. For each T it first tries per-GPU batch 2,
+then per-GPU batch 1 (a semantics-preserving saving: the global batch stays 16, FastGen recomputes grad
+accumulation). It stops at the first (T, batch) whose peak `torch.cuda.max_memory_allocated()` stays within
+`--max_frac` of GPU memory on every rank. Each trial is a real `train.py` run of the experiment config for
+`--max_iter` iterations. With `student_update_freq=5` that covers critic steps (iters 1-4, 6-9) and student
+steps (iters 5, 10).
+
+Worker mode (`--probe_out` set; launched by the driver through torchrun) runs exactly what `train.py` runs,
+with two probe-only changes that do not touch repo code:
+  * `Trainer.save_checkpoint` is a no-op, so the probe never writes ~17 GB checkpoints.
+  * Each rank writes `rank<k>.json` with its peak memory and status (ok / oom / error).
+
+Usage (on a GPU node, from the repo root, with the venv active):
+    python scripts/probe_frames.py --ngpu 2 --out runs/probe_frames -- <extra train.py overrides>
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import traceback
+
+LADDER = [21, 16, 13, 9, 5]  # latent T -> pixel frames (T - 1) * 4 + 1: 81, 61, 49, 33, 17
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# worker
+# ---------------------------------------------------------------------------------------------------------------
+def _write(out_dir: str, payload: dict) -> None:
+    rank = int(os.environ.get("RANK", 0))
+    with open(os.path.join(out_dir, f"rank{rank}.json"), "w") as f:
+        json.dump(payload, f, indent=1)
+
+
+def worker(out_dir: str) -> None:
+    sys.path.insert(0, REPO)
+    import torch
+
+    import train as train_entry
+    import fastgen.utils.logging_utils as logger
+    from fastgen.trainer import Trainer
+    from fastgen.utils.distributed import clean_up
+    from fastgen.utils.scripts import parse_args, setup
+
+    def _no_save(self, model, iteration, path=None):  # probe only: never write checkpoints
+        logger.warning(f"[probe] skipping save_checkpoint at iteration {iteration}")
+        return None
+
+    Trainer.save_checkpoint = _no_save
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--probe_out", required=True)
+    args = parse_args(parser)
+    t0 = time.time()
+    status, err = "ok", ""
+    try:
+        config = setup(args)
+        train_entry.main(config)
+    except torch.OutOfMemoryError as e:
+        status, err = "oom", str(e).splitlines()[0]
+    except Exception as e:  # NCCL errors caused by an OOM on another rank end up here too
+        status, err = ("oom" if "out of memory" in str(e).lower() else "error"), traceback.format_exc()[-3000:]
+    dev = torch.cuda.current_device()
+    _write(
+        out_dir,
+        {
+            "status": status,
+            "error": err,
+            "gpu": torch.cuda.get_device_name(dev),
+            "total_gb": torch.cuda.get_device_properties(dev).total_memory / 1024**3,
+            "max_allocated_gb": torch.cuda.max_memory_allocated(dev) / 1024**3,
+            "max_reserved_gb": torch.cuda.max_memory_reserved(dev) / 1024**3,
+            "elapsed_s": time.time() - t0,
+        },
+    )
+    if status == "ok":
+        clean_up()
+    else:
+        os._exit(1)  # do not wait on collectives that will never complete
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# driver
+# ---------------------------------------------------------------------------------------------------------------
+def trial(T: int, bs: int, a: argparse.Namespace, extra: list[str]) -> dict:
+    name = f"T{T}_bs{bs}"
+    out_dir = os.path.abspath(os.path.join(a.out, f"{name}_{time.strftime('%Y%m%d-%H%M%S')}"))
+    os.makedirs(out_dir)
+    seq_len = (T - 1) * 4 + 1
+    cmd = [
+        "torchrun", f"--nproc_per_node={a.ngpu}", "--standalone", os.path.abspath(__file__),
+        "--probe_out", out_dir,
+        "--config", a.config, "-",
+        f"model.input_shape=[16,{T},60,104]",
+        f"dataloader_train.sequence_length={seq_len}",
+        f"dataloader_train.batch_size={bs}",
+        f"trainer.max_iter={a.max_iter}",
+        f"trainer.logging_iter={a.max_iter - 1}",
+        "trainer.save_ckpt_iter=1000000",
+        f"log_config.name=probe_{name}",
+        *extra,
+    ]
+    env = dict(os.environ, FASTGEN_OUTPUT_ROOT=os.path.join(os.path.abspath(a.out), "fastgen_output"))
+    log_path = os.path.join(out_dir, "train.log")
+    print(f"[probe] {name}: seq_len={seq_len} -> {log_path}", flush=True)
+    with open(log_path, "w") as log:
+        log.write(" ".join(cmd) + "\n\n")
+        log.flush()
+        p = subprocess.Popen(cmd, cwd=REPO, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+        t0, killed = time.time(), ""
+        while p.poll() is None:
+            time.sleep(10)
+            done = [f for f in os.listdir(out_dir) if f.startswith("rank") and f.endswith(".json")]
+            failed = any(json.load(open(os.path.join(out_dir, f)))["status"] != "ok" for f in done)
+            if failed or time.time() - t0 > a.timeout_min * 60:
+                killed = "rank failure" if failed else "timeout"
+                time.sleep(20)  # give the other ranks a moment to write their own result
+                os.killpg(p.pid, signal.SIGKILL)
+                p.wait()
+    ranks = []
+    for r in range(a.ngpu):
+        f = os.path.join(out_dir, f"rank{r}.json")
+        ranks.append(json.load(open(f)) if os.path.exists(f) else {"status": "no_result"})
+    statuses = {x["status"] for x in ranks}
+    status = "ok" if statuses == {"ok"} else ("oom" if "oom" in statuses else sorted(statuses - {"ok"})[0])
+    peak = max((x.get("max_allocated_gb", 0) for x in ranks), default=0)
+    total = min((x.get("total_gb", 1e9) for x in ranks if "total_gb" in x), default=None)
+    res = {
+        "T": T, "pixel_frames": seq_len, "per_gpu_batch": bs, "status": status, "killed": killed,
+        "peak_allocated_gb": peak, "peak_reserved_gb": max((x.get("max_reserved_gb", 0) for x in ranks), default=0),
+        "total_gb": total, "peak_frac": (peak / total) if total else None, "ranks": ranks,
+        "fits": status == "ok" and total is not None and peak <= a.max_frac * total,
+    }
+    print(f"[probe] {name}: status={status} peak_alloc={peak:.2f} GB "
+          f"({(res['peak_frac'] or 0) * 100:.1f} %) fits={res['fits']}", flush=True)
+    return res
+
+
+def driver() -> None:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--ngpu", type=int, default=2)
+    ap.add_argument("--config", default="fastgen/configs/experiments/WanT2V/config_dmd2.py")
+    ap.add_argument("--ladder", type=int, nargs="+", default=LADDER)
+    ap.add_argument("--batch_sizes", type=int, nargs="+", default=[2, 1])
+    ap.add_argument("--max_iter", type=int, default=11, help="iters 1..max_iter-1 run; 5 and 10 are student steps")
+    ap.add_argument("--max_frac", type=float, default=0.90)
+    ap.add_argument("--timeout_min", type=float, default=60)
+    ap.add_argument("--all", action="store_true", help="probe every (T, batch) instead of stopping at the first fit")
+    ap.add_argument("--out", default="runs/probe_frames")
+    ap.add_argument("extra", nargs=argparse.REMAINDER, help="extra train.py overrides after `--`")
+    a = ap.parse_args()
+    extra = [x for x in a.extra if x != "--"]
+    assert all(t >= 5 for t in a.ladder), "spec §2.5: never go below T=5"
+    os.makedirs(a.out, exist_ok=True)
+    results, chosen = [], None
+    for T in a.ladder:
+        for bs in a.batch_sizes:
+            r = trial(T, bs, a, extra)
+            results.append(r)
+            with open(os.path.join(a.out, "probe_results.json"), "w") as f:
+                json.dump({"extra_overrides": extra, "results": results}, f, indent=1)
+            if r["fits"] and chosen is None:
+                chosen = r
+                if not a.all:
+                    break
+        if chosen is not None and not a.all:
+            break
+    print("[probe] summary:")
+    for r in results:
+        print(f"  T={r['T']:>2} ({r['pixel_frames']:>2}f) bs={r['per_gpu_batch']} status={r['status']:<8} "
+              f"peak_alloc={r['peak_allocated_gb']:.2f} GB peak_reserved={r['peak_reserved_gb']:.2f} GB "
+              f"frac={(r['peak_frac'] or 0) * 100:.1f} % fits={r['fits']}")
+    print(f"[probe] chosen: {None if chosen is None else (chosen['T'], chosen['per_gpu_batch'])}")
+
+
+if __name__ == "__main__":
+    if "--probe_out" in sys.argv:
+        worker(sys.argv[sys.argv.index("--probe_out") + 1])
+    else:
+        driver()
diff --git a/scripts/train_dfd.py b/scripts/train_dfd.py
new file mode 100644
index 0000000..acd5b8a
--- /dev/null
+++ b/scripts/train_dfd.py
@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: Apache-2.0
+"""`train.py` plus a per-submodule load report (spec §0 rule 3, Claude.md hard rule).
+
+Same CLI and training behavior as `train.py`: it calls `train.main` unchanged. The only addition is a wrapper
+around `Trainer.load_pretrained_ckpt`: after the original loading runs, it reports for each of `net`, `fake_score`,
+`discriminator` and `teacher` the parameter count, dtypes, where the weights came from, and the missing / unexpected
+keys against that source:
+  * checkpoint key (from `pretrained_ckpt_key_map`)       -> DCP metadata `<prefix>.<key>_model/.metadata`
+  * `net` / `teacher` / `fake_score` not in the key map   -> HF Wan transformer safetensors index (`transformer.` prefix)
+  * `discriminator` not in the key map                    -> random init (no source)
+The report is logged on rank 0 and written to `<log_config.save_path>/load_report.json`. Any non-empty missing
+list is logged at CRITICAL level.
+
+Usage: torchrun ... scripts/train_dfd.py --config <cfg> - <overrides>   (identical to train.py)
+"""
+
+import glob
+import json
+import os
+import sys
+from collections import Counter
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, REPO)
+
+import argparse  # noqa: E402
+
+import train as train_entry  # noqa: E402
+import fastgen.utils.logging_utils as logger  # noqa: E402
+from fastgen.trainer import Trainer  # noqa: E402
+from fastgen.utils.distributed import clean_up, is_rank0  # noqa: E402
+from fastgen.utils.scripts import parse_args, setup  # noqa: E402
+
+SUBMODULES = ["net", "fake_score", "discriminator", "teacher"]
+
+
+def _hf_transformer_keys(model_id: str) -> tuple[str, set]:
+    repo = "models--" + model_id.replace("/", "--")
+    hits = glob.glob(os.path.join(os.environ["HF_HOME"], repo, "snapshots", "*", "transformer",
+                                  "diffusion_pytorch_model.safetensors.index.json"))
+    if not hits:
+        return f"HF {model_id} (index not found)", None
+    return f"HF {model_id}", {"transformer." + k for k in json.load(open(hits[0]))["weight_map"]}
+
+
+def _dcp_keys(path: str) -> set:
+    from torch.distributed.checkpoint import FileSystemReader
+
+    return set(FileSystemReader(path).read_metadata().state_dict_metadata.keys())
+
+
+def load_report(trainer: Trainer, model) -> dict:
+    cfg = trainer.config.trainer.checkpointer
+    key_map = dict(cfg.pretrained_ckpt_key_map or {})
+    report = {}
+    for name in SUBMODULES:
+        m = getattr(model, name, None)
+        if m is None:
+            report[name] = {"present": False}
+            continue
+        keys = set(m.state_dict().keys())
+        entry = {
+            "present": True,
+            "n_params": int(sum(p.numel() for p in m.parameters())),
+            "dtypes": dict(Counter(str(p.dtype) for p in m.parameters())),
+            "n_state_dict_keys": len(keys),
+        }
+        if name in key_map and cfg.pretrained_ckpt_path:
+            src = f"{cfg.pretrained_ckpt_path}.{key_map[name]}_model"
+            ref = _dcp_keys(src)
+        elif name == "discriminator":
+            src, ref = "random init", None
+        else:
+            src, ref = _hf_transformer_keys(getattr(m, "model_id", "Wan-AI/Wan2.1-T2V-1.3B-Diffusers"))
+        entry["source"] = src
+        if ref is not None:
+            entry["missing"] = sorted(keys - ref)  # in the module, absent from the source
+            entry["unexpected"] = sorted(ref - keys)  # in the source, absent from the module
+        report[name] = entry
+    return report
+
+
+_orig_load = Trainer.load_pretrained_ckpt
+
+
+def _load_with_report(self, model, *args, **kwargs):
+    out = _orig_load(self, model, *args, **kwargs)
+    if is_rank0():
+        rep = load_report(self, model)
+        for name, e in rep.items():
+            if not e["present"]:
+                logger.info(f"[load-report] {name}: not present")
+                continue
+            miss, unexp = e.get("missing"), e.get("unexpected")
+            msg = (f"[load-report] {name}: source={e['source']} params={e['n_params'] / 1e9:.4f}B dtypes={e['dtypes']} "
+                   f"missing={None if miss is None else len(miss)} unexpected={None if unexp is None else len(unexp)}")
+            (logger.critical if miss else logger.info)(msg + (f" first missing: {miss[:5]}" if miss else ""))
+            if unexp:
+                logger.warning(f"[load-report] {name}: first unexpected: {unexp[:5]}")
+        path = os.path.join(self.config.log_config.save_path, "load_report.json")
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        json.dump(rep, open(path, "w"), indent=1)
+        logger.info(f"[load-report] written to {path}")
+    return out
+
+
+Trainer.load_pretrained_ckpt = _load_with_report
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Training (train.py + load report)")
+    args = parse_args(parser)
+    config = setup(args)
+    train_entry.main(config)
+    clean_up()
+    logger.info("Training finished.")
diff --git a/tests/test_dfd_flags.py b/tests/test_dfd_flags.py
new file mode 100644
index 0000000..0ce54a9
--- /dev/null
+++ b/tests/test_dfd_flags.py
@@ -0,0 +1,288 @@
+# SPDX-License-Identifier: Apache-2.0
+"""DFD experiment flags in DMD2Model (dfd_student_input_key, dfd_diagnostics_every).
+
+1. Flags off: losses and gradients equal the original DFD dmd2.py (loaded from the base commit) bit-exactly.
+2. dfd_student_input_key: the student input is built from the second stream, not from data["real"].
+3. dfd_diagnostics_every: the loss is unchanged (diagnostics are no-grad and use their own RNG) and rows are written.
+"""
+
+import gc
+import importlib.util
+import json
+import os
+import subprocess
+import sys
+
+import pytest
+
+# bit-exact comparisons need deterministic GPU kernels (conv/matmul backward otherwise uses atomics)
+os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
+import torch  # noqa: E402
+
+torch.backends.cudnn.deterministic = True
+torch.backends.cudnn.benchmark = False
+torch.use_deterministic_algorithms(True)
+
+from fastgen.configs.config_utils import override_config_with_opts
+from fastgen.configs.methods.config_dmd2 import ModelConfig
+from fastgen.methods import DMD2Model
+
+BASE_COMMIT = "de6416c"
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def original_dmd2_class(tmp_dir):
+    src = subprocess.run(["git", "show", f"{BASE_COMMIT}:fastgen/methods/distribution_matching/dmd2.py"],
+                         cwd=REPO, check=True, capture_output=True, text=True).stdout
+    path = os.path.join(tmp_dir, "dmd2_original.py")
+    open(path, "w").write(src)
+    spec = importlib.util.spec_from_file_location("dmd2_original", path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["dmd2_original"] = mod
+    spec.loader.exec_module(mod)
+    return mod.DMD2Model
+
+
+def make_config(**over):
+    c = ModelConfig()
+    c.net = override_config_with_opts(c.net, ["-", "img_resolution=8", "channel_mult=[1]", "channel_mult_noise=1"])
+    c.discriminator = override_config_with_opts(c.discriminator, ["-", "feature_indices=[0]", "all_res=[8]", "in_channels=128"])
+    c.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    c.precision = "float32"
+    c.pretrained_model_path = ""
+    c.student_update_freq = 2
+    c.input_shape = [3, 8, 8]
+    c.gan_loss_weight_gen = 0.0
+    c.post_train = True
+    c.gen_real_replace_prob = 0.5
+    c.guidance_scale = 3.0
+    c.student_sample_steps = 2
+    for k, v in over.items():
+        setattr(c, k, v)
+    return c
+
+
+def build(cls, cfg, seed=0):
+    gc.collect()
+    torch.manual_seed(seed)
+    m = cls(cfg)
+    m.on_train_begin()
+    m.init_optimizers()
+    return m
+
+
+def make_data(model, seed=123, extra=None):
+    g = torch.Generator().manual_seed(seed)
+    labels = torch.nn.functional.one_hot(torch.randint(0, 10, (1,), generator=g), num_classes=10)
+    d = {
+        "real": torch.randn(1, 3, 8, 8, generator=g).to(model.device, model.precision),
+        "condition": labels.to(model.device, model.precision),
+        "neg_condition": torch.zeros(1, 10).to(model.device, model.precision),
+    }
+    d.update(extra or {})
+    return d
+
+
+def run_step(model, data, iteration, seed=7):
+    torch.manual_seed(seed)
+    loss_map, outputs = model.single_train_step(data, iteration)
+    loss_map["total_loss"].backward()
+    grads = [p.grad.detach().clone() for p in model.net.parameters() if p.grad is not None]
+    return loss_map, outputs, grads
+
+
+@pytest.mark.parametrize("iteration", [0, 1, 2, 3])  # student, fake-score, student, fake-score
+@pytest.mark.parametrize("p", [0.0, 0.5, 1.0])
+def test_flags_off_match_original(tmp_path, iteration, p):
+    Orig = original_dmd2_class(str(tmp_path))
+    cfg = make_config(gen_real_replace_prob=p)
+    new, old = build(DMD2Model, cfg), build(Orig, make_config(gen_real_replace_prob=p))
+    for a, b in zip(new.net.parameters(), old.net.parameters()):
+        assert torch.equal(a, b)
+    l1, o1, g1 = run_step(new, make_data(new), iteration)
+    l2, o2, g2 = run_step(old, make_data(old), iteration)
+    assert l1.keys() == l2.keys()
+    for k in l1:
+        assert torch.equal(l1[k], l2[k]), k
+    for k in o1:
+        if isinstance(o1[k], torch.Tensor):
+            assert torch.equal(o1[k], o2[k]), k
+    assert len(g1) == len(g2) and all(torch.equal(a, b) for a, b in zip(g1, g2))
+
+
+def capture_student_input(model):
+    seen = []
+    orig = model.gen_data_from_net
+
+    def wrapped(input_student, t_student, **kw):
+        seen.append((input_student.detach().clone(), t_student.detach().clone()))
+        return orig(input_student, t_student, **kw)
+
+    model.gen_data_from_net = wrapped
+    return seen
+
+
+@pytest.mark.parametrize("iteration", [0, 1])  # student update and fake-score update both use the student input
+def test_student_input_key_uses_second_stream(iteration):
+    c = 1.0e6
+    m_on = build(DMD2Model, make_config(dfd_student_input_key="student_real"))
+    m_off = build(DMD2Model, make_config())
+    d = make_data(m_on)
+    d["real"] = torch.zeros_like(d["real"])
+    d["student_real"] = torch.full_like(d["real"], c)
+    seen_on, seen_off = capture_student_input(m_on), capture_student_input(m_off)
+    torch.manual_seed(7)
+    m_on.single_train_step(dict(d), iteration)
+    torch.manual_seed(7)
+    m_off.single_train_step(dict(d), iteration)
+    (x_on, t_on), (x_off, t_off) = seen_on[0], seen_off[0]
+    ns = m_on.net.noise_scheduler
+    # same t_student; input = alpha(t) * c + sigma(t) * eps' with c from data["student_real"], vs sigma * eps from real=0
+    assert torch.equal(t_on, t_off)
+    alpha = ns.alpha(t_on).float().item()
+    assert abs(x_on.float().mean().item() / (alpha * c) - 1) < 1e-2
+    assert x_off.float().abs().mean().item() < 1e-3 * alpha * c
+
+
+def test_student_input_key_single_step_is_noop():
+    m = build(DMD2Model, make_config(student_sample_steps=1, dfd_student_input_key="student_real"))
+    d = make_data(m)
+    d["student_real"] = torch.full_like(d["real"], 1.0e4)
+    ref = build(DMD2Model, make_config(student_sample_steps=1))
+    l1, _, _ = run_step(m, d, 0)
+    l2, _, _ = run_step(ref, make_data(ref), 0)
+    assert torch.equal(l1["total_loss"], l2["total_loss"])
+
+
+@pytest.mark.parametrize("p", [0.0, 1.0])
+def test_diagnostics_do_not_change_loss(tmp_path, p):
+    diag = str(tmp_path / "diag")
+    m_on = build(DMD2Model, make_config(gen_real_replace_prob=p, dfd_diagnostics_every=1, dfd_diagnostics_dir=diag))
+    m_off = build(DMD2Model, make_config(gen_real_replace_prob=p))
+    for it in (2, 3, 4):  # student, fake-score, student
+        l1, _, g1 = run_step(m_on, make_data(m_on), it)
+        l2, _, g2 = run_step(m_off, make_data(m_off), it)
+        for k in l1:
+            assert torch.equal(l1[k], l2[k]), (it, k)
+        assert all(torch.equal(a, b) for a, b in zip(g1, g2))
+    rows = [json.loads(l) for l in open(os.path.join(diag, "rank0.jsonl"))]
+    assert [r["iteration"] for r in rows] == [2, 4]
+    assert all(r["replaced"] == (p == 1.0) for r in rows)
+    for r in rows:
+        for k in ("delta_sq", "score_diff_sq", "xt_diff_norm", "lipschitz_hat", "teacher_x0_diff_sq"):
+            assert r[k] == r[k] and r[k] >= 0, (k, r[k])  # finite, non-negative
+    sk = [f for f in os.listdir(diag) if f.startswith("sketch_")]
+    assert len(sk) == 2
+    s = torch.load(os.path.join(diag, sorted(sk)[0]))
+    assert s["sketch"].shape == (1, m_on.config.dfd_diagnostics_sketch_dim)
+    # count sketch preserves the squared norm in expectation; with D >> N it is exact up to collisions
+    assert abs(float(s["sketch"].pow(2).sum()) / rows[0]["score_diff_sq"] - 1) < 0.2
+
+
+def test_diagnostics_every_skips_steps(tmp_path):
+    diag = str(tmp_path / "diag")
+    m = build(DMD2Model, make_config(dfd_diagnostics_every=2, dfd_diagnostics_dir=diag))
+    for it in (2, 4, 6, 8):  # student updates 1..4 -> logged at 1 and 3
+        run_step(m, make_data(m), it)
+    rows = [json.loads(l) for l in open(os.path.join(diag, "rank0.jsonl"))]
+    assert [r["student_step"] for r in rows] == [1, 3]
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# E3: dfd_cfg_uncond_on_gen
+# ---------------------------------------------------------------------------------------------------------------
+def capture_cfg_inputs(model):
+    seen = []
+    orig = model._apply_classifier_free_guidance
+
+    def wrapped(perturbed, t, teacher_x0, neg_condition=None):
+        seen.append(perturbed.detach().clone())
+        return orig(perturbed, t, teacher_x0, neg_condition=neg_condition)
+
+    model._apply_classifier_free_guidance = wrapped
+    return seen
+
+
+def test_e3_no_replacement_matches_off():
+    # p = 0: never replaced, so the flag must not change anything
+    m_on = build(DMD2Model, make_config(gen_real_replace_prob=0.0, dfd_cfg_uncond_on_gen=True))
+    m_off = build(DMD2Model, make_config(gen_real_replace_prob=0.0))
+    l1, _, g1 = run_step(m_on, make_data(m_on), 0)
+    l2, _, g2 = run_step(m_off, make_data(m_off), 0)
+    assert torch.equal(l1["total_loss"], l2["total_loss"])
+    assert all(torch.equal(a, b) for a, b in zip(g1, g2))
+
+
+def test_e3_uncond_at_gen_point_when_replaced():
+    m_on = build(DMD2Model, make_config(gen_real_replace_prob=1.0, dfd_cfg_uncond_on_gen=True))
+    m_off = build(DMD2Model, make_config(gen_real_replace_prob=1.0))
+    s_on, s_off = capture_cfg_inputs(m_on), capture_cfg_inputs(m_off)
+    captured = {}
+    for m, name in ((m_on, "on"), (m_off, "off")):
+        orig_fp = m.net.noise_scheduler.forward_process
+        calls = []
+
+        def fp(x, e, t, _orig=orig_fp, _calls=calls):
+            out = _orig(x, e, t)
+            _calls.append(out.detach().clone())
+            return out
+
+        m.net.noise_scheduler.forward_process = fp
+        captured[name] = calls
+    l_on, _, _ = run_step(m_on, make_data(m_on), 0)
+    l_off, _, _ = run_step(m_off, make_data(m_off), 0)
+    # forward_process calls in the student step: [input_student, perturbed_data (gen), perturbed_data_teacher_score (real)]
+    gen_pt_on, real_pt_on = captured["on"][-2], captured["on"][-1]
+    real_pt_off = captured["off"][-1]
+    assert torch.equal(s_on[0], gen_pt_on) and not torch.equal(s_on[0], real_pt_on)
+    assert torch.equal(s_off[0], real_pt_off)
+    assert not torch.equal(l_on["total_loss"], l_off["total_loss"])
+
+
+def test_e3_with_diagnostics_loss_unchanged(tmp_path):
+    diag = str(tmp_path / "diag")
+    m_d = build(DMD2Model, make_config(gen_real_replace_prob=1.0, dfd_cfg_uncond_on_gen=True, dfd_diagnostics_every=1,
+                                       dfd_diagnostics_dir=diag))
+    m = build(DMD2Model, make_config(gen_real_replace_prob=1.0, dfd_cfg_uncond_on_gen=True))
+    l1, _, g1 = run_step(m_d, make_data(m_d), 2)
+    l2, _, g2 = run_step(m, make_data(m), 2)
+    assert torch.equal(l1["total_loss"], l2["total_loss"])
+    assert all(torch.equal(a, b) for a, b in zip(g1, g2))
+    rows = [json.loads(l) for l in open(os.path.join(diag, "rank0.jsonl"))]
+    assert len(rows) == 1 and rows[0]["replaced"]
+
+
+# ---------------------------------------------------------------------------------------------------------------
+# E4: dfd_inverted_noise_key
+# ---------------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("iteration", [0, 1])
+def test_e4_inverted_noise_multistep(iteration):
+    m = build(DMD2Model, make_config(dfd_inverted_noise_key="z_inv"))
+    d = make_data(m)
+    g = torch.Generator().manual_seed(5)
+    d["z_inv"] = torch.randn(d["real"].shape, generator=g).to(m.device, m.precision)
+    seen = capture_student_input(m)
+    torch.manual_seed(7)
+    m.single_train_step(dict(d), iteration)
+    x, t = seen[0]
+    expect = m.net.noise_scheduler.forward_process(d["real"], d["z_inv"], t)
+    assert torch.equal(x, expect)
+
+
+def test_e4_inverted_noise_single_step():
+    m = build(DMD2Model, make_config(student_sample_steps=1, dfd_inverted_noise_key="z_inv"))
+    d = make_data(m)
+    d["z_inv"] = torch.randn_like(d["real"])
+    seen = capture_student_input(m)
+    torch.manual_seed(7)
+    m.single_train_step(dict(d), 0)
+    assert torch.equal(seen[0][0], m.net.noise_scheduler.latents(noise=d["z_inv"]))
+
+
+def test_e4_rejects_e2s_arm():
+    m = build(DMD2Model, make_config(dfd_inverted_noise_key="z_inv", dfd_student_input_key="student_real"))
+    d = make_data(m)
+    d["z_inv"] = torch.randn_like(d["real"])
+    d["student_real"] = torch.randn_like(d["real"])
+    with pytest.raises(AssertionError):
+        m.single_train_step(d, 0)
