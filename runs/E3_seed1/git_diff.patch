@@ -0,0 +1,45 @@
+#!/bin/bash
+# Generate the fixed VBench subset (runs/eval/vbench_subset/prompts.txt, 160 prompts) for one checkpoint:
+# 5 samples per prompt = 5 inference runs with trainer.seed = 0..4 (sample index k uses seed k).
+# The student sampler is deterministic ("ode"), and every prompt of one run starts from the same seed-k noise, so
+# all models see identical initial noise (paired comparison). Seeds are spread over the visible GPUs.
+#
+# Usage (inside a Slurm allocation, from the repo root):
+#   scripts/eval/gen_vbench_subset.sh <ckpt_prefix> <tag> [latent_T=21]
+# Output: runs/eval/<tag>/raw/seed<k>/...mp4 and runs/eval/<tag>/videos/<prompt>-<k>.mp4 (symlinks, VBench naming)
+set -euo pipefail
+CKPT=$1
+TAG=$2
+T=${3:-21}
+cd /gpfs/home/j/jiayang_gu/workspace/data-forcing-distillation
+source .venv/bin/activate
+OUT=runs/eval/$TAG
+PROMPTS=runs/eval/vbench_subset/prompts.txt
+mkdir -p $OUT/raw $OUT/logs
+SEQ=$(( (T - 1) * 4 + 1 ))
+echo "ckpt=$CKPT tag=$TAG T=$T ($SEQ frames)" | tee $OUT/gen_info.txt
+NGPU=$(nvidia-smi -L | wc -l)
+run_seed() {
+  local k=$1 gpu=$2 rc=0
+  CUDA_VISIBLE_DEVICES=$gpu torchrun --nnodes=1 --nproc_per_node=1 --master_port=$((29500 + k)) \
+    scripts/inference/video_model_inference.py \
+    --ckpt_path $CKPT \
+    --do_student_sampling True \
+    --do_teacher_sampling False \
+    --prompt_file $PROMPTS \
+    --config fastgen/configs/experiments/WanT2V/config_dmd2.py \
+    --save_as_gif False \
+    --video_save_dir $OUT/raw/seed$k - \
+    trainer.seed=$k trainer.fsdp=True trainer.ddp=False \
+    "model.input_shape=[16,$T,60,104]" \
+    log_config.name=vbench_${TAG}_seed$k > $OUT/logs/seed$k.log 2>&1 || rc=$?
+  echo "seed $k on gpu $gpu: exit $rc"
+}
+# round-robin the seeds over the GPUs; one process per GPU at a time. SEEDS (env, default "0 1 2 3 4") lets a
+# failed seed be regenerated alone; the other seeds' videos are kept.
+read -r -a SEED_LIST <<< "${SEEDS:-0 1 2 3 4}"
+for ((g = 0; g < NGPU; g++)); do
+  ( for ((i = g; i < ${#SEED_LIST[@]}; i += NGPU)); do run_seed ${SEED_LIST[$i]} $g; done ) &
+done
+wait
+python3 scripts/eval/link_vbench_names.py --prompts $PROMPTS --raw $OUT/raw --out $OUT/videos
diff --git a/scripts/eval/link_vbench_names.py b/scripts/eval/link_vbench_names.py
new file mode 100644
index 0000000..72c0b69
--- /dev/null
+++ b/scripts/eval/link_vbench_names.py
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Expose inference outputs under VBench's standard file names `<prompt>-<k>.mp4` via relative symlinks.
+
+`video_model_inference.py` writes `<raw>/seed<k>/<prompt_file_stem>/student_step4_<i:04d>_seed<k>.mp4`, where i is
+the line index in the prompt file. Fails loudly if any of the len(prompts) x 5 videos is missing.
+"""
+
+import argparse
+import glob
+import os
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--prompts", required=True)
+    ap.add_argument("--raw", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--samples", type=int, default=5)
+    a = ap.parse_args()
+    prompts = [line.rstrip("\n") for line in open(a.prompts) if line.strip()]
+    os.makedirs(a.out, exist_ok=True)
+    missing = []
+    for k in range(a.samples):
+        for i, p in enumerate(prompts):
+            hits = glob.glob(os.path.join(a.raw, f"seed{k}", "*", f"student_step*_{i:04d}_seed{k}.mp4"))
+            if len(hits) != 1:
+                missing.append((k, i, len(hits)))
+                continue
+            dst = os.path.join(a.out, f"{p}-{k}.mp4")
+            if os.path.islink(dst):
+                os.unlink(dst)  # replace a symlink created by an earlier run
+            elif os.path.exists(dst):
+                raise SystemExit(f"{dst} exists and is not a symlink; refusing to touch it")
+            os.symlink(os.path.relpath(hits[0], a.out), dst)
+    n = len(prompts) * a.samples
+    print(f"linked {n - len(missing)}/{n} videos into {a.out}")
+    if missing:
+        raise SystemExit(f"missing or ambiguous (seed, prompt_idx, hits): {missing[:20]}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/eval/make_vbench_subset.py b/scripts/eval/make_vbench_subset.py
new file mode 100644
index 0000000..30d532b
--- /dev/null
+++ b/scripts/eval/make_vbench_subset.py
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Build the fixed VBench subset used for every model (spec §6, decision of 2026-09-24).
+
+200 videos per Quality-Score dimension = 40 official prompts x 5 samples. The 7 quality dimensions use 4 disjoint
+official prompt sets, so prompts are sampled once per set and shared by the dimensions of that set:
+
+    {subject_consistency, motion_smoothness, dynamic_degree}: 72 prompts
+    {background_consistency}: 86
+    {temporal_flickering}: 75
+    {aesthetic_quality, imaging_quality}: 93
+
+-> 160 prompts x 5 samples = 800 videos per evaluated model.
+
+Outputs (in --out):
+    prompts.txt           one prompt per line, fixed order (input of scripts/inference/video_model_inference.py)
+    subset_full_info.json VBench full_info restricted to the chosen prompts and the 7 quality dimensions
+    subset_meta.json      seed, per-dimension prompt counts, source file checksum
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import random
+
+QUALITY_DIMS = [
+    "subject_consistency",
+    "background_consistency",
+    "temporal_flickering",
+    "motion_smoothness",
+    "dynamic_degree",
+    "aesthetic_quality",
+    "imaging_quality",
+]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--full_info", default="runs/eval/vbench_subset/VBench_full_info_official.json")
+    ap.add_argument("--out", default="runs/eval/vbench_subset")
+    ap.add_argument("--prompts_per_dim", type=int, default=40)
+    ap.add_argument("--seed", type=int, default=0)
+    a = ap.parse_args()
+
+    raw = open(a.full_info, "rb").read()
+    info = json.loads(raw)
+    # prompt -> set of quality dimensions it is officially used for (merges the few duplicated entries)
+    dims_of = {}
+    for e in info:
+        q = [d for d in e["dimension"] if d in QUALITY_DIMS]
+        if q:
+            dims_of.setdefault(e["prompt_en"], set()).update(q)
+
+    # group dimensions that share exactly the same official prompt set
+    groups = {}
+    for d in QUALITY_DIMS:
+        groups.setdefault(frozenset(p for p, ds in dims_of.items() if d in ds), []).append(d)
+    rng = random.Random(a.seed)
+    chosen = {}  # prompt -> dims
+    for prompt_set, dims in sorted(groups.items(), key=lambda kv: QUALITY_DIMS.index(kv[1][0])):
+        assert not (prompt_set & chosen.keys()), "quality prompt sets are expected to be disjoint"
+        for p in rng.sample(sorted(prompt_set), a.prompts_per_dim):
+            chosen[p] = sorted(dims_of[p] & set(dims), key=QUALITY_DIMS.index)
+
+    prompts = list(chosen)
+    assert all("\n" not in p and "/" not in p for p in prompts), "prompts are used as file names"
+    os.makedirs(a.out, exist_ok=True)
+    with open(os.path.join(a.out, "prompts.txt"), "w") as f:
+        f.write("\n".join(prompts) + "\n")
+    with open(os.path.join(a.out, "subset_full_info.json"), "w") as f:
+        json.dump([{"prompt_en": p, "dimension": chosen[p]} for p in prompts], f, indent=1)
+    per_dim = {d: sum(d in ds for ds in chosen.values()) for d in QUALITY_DIMS}
+    meta = {
+        "source": a.full_info,
+        "source_sha256": hashlib.sha256(raw).hexdigest(),
+        "seed": a.seed,
+        "prompts_per_dim": a.prompts_per_dim,
+        "samples_per_prompt": 5,
+        "num_prompts": len(prompts),
+        "prompts_per_dimension": per_dim,
+        "videos_per_dimension": {d: n * 5 for d, n in per_dim.items()},
+        "groups": [dims for dims in groups.values()],
+    }
+    with open(os.path.join(a.out, "subset_meta.json"), "w") as f:
+        json.dump(meta, f, indent=1)
+    print(json.dumps(meta, indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/eval/paired_bootstrap.py b/scripts/eval/paired_bootstrap.py
new file mode 100644
index 0000000..c31369f
--- /dev/null
+++ b/scripts/eval/paired_bootstrap.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Paired bootstrap of VBench subset results for two models evaluated on the same prompts and seeds.
+
+Resampling unit = prompt (its 5 seed videos stay together). The dimensions of one official prompt group share the
+same resampled prompts; groups are resampled independently. Each replicate recomputes every dimension mean and the
+Quality Score (official normalization / weights) for both models; the script reports B − A with a 95 % percentile CI.
+
+Usage: python scripts/eval/paired_bootstrap.py <A_eval_results.json> <B_eval_results.json> [--n 10000] [--out f.json]
+"""
+
+import argparse
+import json
+import os
+import re
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from vbench_quality_score import NORMALIZE, WEIGHT  # noqa: E402
+
+SCALE = {"imaging_quality": 0.01}  # per-video MUSIQ scores are 0-100, the aggregate is 0-1
+
+
+def per_video(results: dict) -> dict:
+    """dim -> {(prompt, k): value}"""
+    out = {}
+    for d in NORMALIZE:
+        vals = {}
+        for v in results[d][1]:
+            m = re.match(r"(.*)-(\d+)\.mp4$", os.path.basename(v["video_path"]))
+            vals[(m.group(1), int(m.group(2)))] = float(v["video_results"]) * SCALE.get(d, 1.0)
+        out[d] = vals
+    return out
+
+
+def quality(means: dict) -> float:
+    return sum(WEIGHT[d] * (means[d] - lo) / (hi - lo) for d, (lo, hi) in NORMALIZE.items()) / sum(WEIGHT.values())
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("a")
+    ap.add_argument("b")
+    ap.add_argument("--n", type=int, default=10000)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out", default=None)
+    args = ap.parse_args()
+    A, B = per_video(json.load(open(args.a))), per_video(json.load(open(args.b)))
+
+    # prompt groups: dims with identical prompt sets
+    groups = {}
+    for d in NORMALIZE:
+        assert A[d].keys() == B[d].keys(), f"{d}: videos differ between A and B"
+        prompts = tuple(sorted({p for p, _ in A[d]}))
+        groups.setdefault(prompts, []).append(d)
+    # per dim: matrix [n_prompts, 5] for A and B, rows ordered like the group's prompt tuple
+    mats = {}
+    for prompts, dims in groups.items():
+        for d in dims:
+            ks = sorted({k for _, k in A[d]})
+            mats[d] = tuple(np.array([[M[d][(p, k)] for k in ks] for p in prompts]) for M in (A, B))
+
+    rng = np.random.default_rng(args.seed)
+    boot = {d: np.empty((args.n, 2)) for d in NORMALIZE}
+    for prompts, dims in groups.items():
+        idx = rng.integers(0, len(prompts), size=(args.n, len(prompts)))
+        for d in dims:
+            ma, mb = mats[d]
+            boot[d][:, 0] = ma.mean(1)[idx].mean(1)
+            boot[d][:, 1] = mb.mean(1)[idx].mean(1)
+    qa = np.array([quality({d: boot[d][i, 0] for d in NORMALIZE}) for i in range(args.n)])
+    qb = np.array([quality({d: boot[d][i, 1] for d in NORMALIZE}) for i in range(args.n)])
+
+    rows = {}
+    point = {d: (mats[d][0].mean(), mats[d][1].mean()) for d in NORMALIZE}
+    for d in NORMALIZE:
+        diff = boot[d][:, 1] - boot[d][:, 0]
+        rows[d] = {"A": point[d][0], "B": point[d][1], "diff": point[d][1] - point[d][0],
+                   "ci95": [float(np.percentile(diff, 2.5)), float(np.percentile(diff, 97.5))],
+                   "p_B_gt_A": float((diff > 0).mean())}
+    qd = qb - qa
+    q_point = (quality({d: point[d][0] for d in NORMALIZE}), quality({d: point[d][1] for d in NORMALIZE}))
+    rows["quality_score"] = {"A": q_point[0], "B": q_point[1], "diff": q_point[1] - q_point[0],
+                             "ci95": [float(np.percentile(qd, 2.5)), float(np.percentile(qd, 97.5))],
+                             "p_B_gt_A": float((qd > 0).mean())}
+    print(f"A = {args.a}\nB = {args.b}\nbootstrap n={args.n}, unit=prompt, groups={list(groups.values())}")
+    print(f"{'metric':24s} {'A':>8s} {'B':>8s} {'B-A':>8s}   95% CI of B-A        P(B>A)")
+    for k, r in rows.items():
+        sig = "*" if r["ci95"][0] > 0 or r["ci95"][1] < 0 else " "
+        print(f"{k:24s} {r['A']:8.4f} {r['B']:8.4f} {r['diff']:+8.4f}   [{r['ci95'][0]:+.4f}, {r['ci95'][1]:+.4f}] {sig}  "
+              f"{r['p_B_gt_A']:.3f}")
+    if args.out:
+        json.dump({"a": args.a, "b": args.b, "n": args.n, "rows": rows}, open(args.out, "w"), indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/eval/run_vbench.py b/scripts/eval/run_vbench.py
new file mode 100644
index 0000000..afa0fc5
--- /dev/null
+++ b/scripts/eval/run_vbench.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Run VBench (standard mode) on the fixed subset for the 7 Quality-Score dimensions. Run inside `.venv-vbench`.
+
+Each dimension is evaluated and saved separately (`<name>_<dim>_eval_results.json`), and finished dimensions are
+skipped on re-runs. The merged result is written to `<name>_eval_results.json`.
+
+Usage:
+    VBENCH_CACHE_DIR=data/vbench_cache .venv-vbench/bin/python scripts/eval/run_vbench.py \
+        --videos runs/eval/<tag>/videos --name <tag> --out runs/eval/<tag>/vbench
+Then: python3 scripts/eval/vbench_quality_score.py runs/eval/<tag>/vbench/<tag>_eval_results.json
+"""
+
+import argparse
+import json
+import os
+
+# VBench 0.1.5 loads its (official, trusted) model weights with plain torch.load; torch >= 2.6 defaults to
+# weights_only=True and rejects e.g. the AMT checkpoint used by motion_smoothness.
+os.environ.setdefault("TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD", "1")
+
+QUALITY_DIMS = [
+    "subject_consistency",
+    "background_consistency",
+    "temporal_flickering",
+    "motion_smoothness",
+    "dynamic_degree",
+    "aesthetic_quality",
+    "imaging_quality",
+]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--videos", required=True)
+    ap.add_argument("--name", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--full_info", default="runs/eval/vbench_subset/subset_full_info.json")
+    ap.add_argument("--dims", nargs="+", default=QUALITY_DIMS)
+    a = ap.parse_args()
+
+    import torch
+    from vbench import VBench
+
+    n = len([f for f in os.listdir(a.videos) if f.endswith(".mp4")])
+    print(f"{n} videos in {a.videos}; dims: {a.dims}", flush=True)
+    bench = VBench(torch.device("cuda"), a.full_info, a.out)
+    merged = {}
+    for dim in a.dims:
+        path = os.path.join(a.out, f"{a.name}_{dim}_eval_results.json")
+        if not os.path.exists(path):
+            print(f"=== evaluating {dim}", flush=True)
+            bench.evaluate(videos_path=a.videos, name=f"{a.name}_{dim}", dimension_list=[dim], mode="vbench_standard")
+        merged.update(json.load(open(path)))
+        print(f"=== {dim}: {merged[dim][0]}", flush=True)
+    with open(os.path.join(a.out, f"{a.name}_eval_results.json"), "w") as f:
+        json.dump(merged, f)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/eval/splice_compare.py b/scripts/eval/splice_compare.py
new file mode 100644
index 0000000..91575d8
--- /dev/null
+++ b/scripts/eval/splice_compare.py
@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Side-by-side comparison videos from the VBench-subset eval videos (same prompt, same seed = same initial noise).
+
+For each selected prompt writes
+  strips/<nn>_<prompt>.mp4  models left to right at full resolution (832x480 each), seed --seed
+  seeds/<nn>_<prompt>.mp4   models as columns, seeds 0-4 as rows, half resolution (shows seed diversity)
+plus all_strips.mp4 (strips concatenated) and overview.jpg (middle frame of every strip).
+
+Usage: python scripts/eval/splice_compare.py --out runs/compare/E0_E1a_E2 \
+         --model E0_dmd2_T21 "E0 | DMD2 start (no DFD)" --model E1a_seed1_it0040 "E1a | DFD + ViPE, step 40" ...
+         [--n_prompts 12] [--select_seed 0] [--seed 0]
+Streams frames (low memory, no torch); runs on the login node.
+"""
+
+import argparse
+import os
+import random
+import re
+import textwrap
+
+import av
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+FONT = "/usr/share/fonts/dejavu/DejaVuSans.ttf"
+FONT_B = "/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf"
+FPS = 16
+
+
+def frames(path, w, h):
+    with av.open(path) as c:
+        for f in c.decode(video=0):
+            yield f.to_image().resize((w, h), Image.BILINEAR) if (f.width, f.height) != (w, h) else f.to_image()
+
+
+def text_bar(width, height, lines, font, color="white", bg=(20, 20, 20)):
+    im = Image.new("RGB", (width, height), bg)
+    d = ImageDraw.Draw(im)
+    y = 6
+    for ln in lines:
+        d.text((10, y), ln, font=font, fill=color)
+        y += font.size + 4
+    return im
+
+
+def write_video(out, frame_iter, size):
+    tmp = out + ".tmp.mp4"
+    with av.open(tmp, "w") as oc:
+        s = oc.add_stream("libx264", rate=FPS, options={"crf": "18", "preset": "fast", "threads": "2"})
+        s.width, s.height, s.pix_fmt = size[0], size[1], "yuv420p"
+        n = 0
+        for im in frame_iter:
+            for pkt in s.encode(av.VideoFrame.from_image(im)):
+                oc.mux(pkt)
+            n += 1
+        for pkt in s.encode():
+            oc.mux(pkt)
+    os.replace(tmp, out)
+    return n
+
+
+def compose(models, paths, prompt, w, h, cols, rows, label_font, prompt_font, row_labels=None):
+    """Yield composed frames: header (model labels), grid of rows x cols videos, footer (prompt)."""
+    n_lines = max(len(label.split("\n")) for _, label in models)  # a label may span several lines ("\n")
+    head_h = (label_font.size + 6) * n_lines + 10
+    wrap = textwrap.wrap(f"Prompt: {prompt}", width=max(40, cols * w // (prompt_font.size * 0.55)))
+    foot_h = (prompt_font.size + 4) * len(wrap) + 12
+    foot_h += (head_h + rows * h + foot_h) % 2  # yuv420p needs even dimensions
+    W, H = cols * w, head_h + rows * h + foot_h
+    head = Image.new("RGB", (W, head_h), (20, 20, 20))
+    d = ImageDraw.Draw(head)
+    for j, (_, label) in enumerate(models):
+        for li, ln in enumerate(label.split("\n")):
+            d.text((j * w + 10, 6 + li * (label_font.size + 6)), ln, font=label_font, fill="white" if li == 0 else (200, 220, 255))
+    foot = text_bar(W, foot_h, wrap, prompt_font, color=(230, 230, 230))
+    its = [[frames(paths[r][j], w, h) for j in range(cols)] for r in range(rows)]
+
+    def gen():
+        while True:
+            canvas = Image.new("RGB", (W, H), "black")
+            canvas.paste(head, (0, 0))
+            try:
+                for r in range(rows):
+                    for j in range(cols):
+                        canvas.paste(next(its[r][j]), (j * w, head_h + r * h))
+            except StopIteration:
+                return
+            if row_labels:
+                dd = ImageDraw.Draw(canvas)
+                for r, rl in enumerate(row_labels):
+                    dd.text((6, head_h + r * h + 4), rl, font=prompt_font, fill="white", stroke_width=2, stroke_fill="black")
+            canvas.paste(foot, (0, head_h + rows * h))
+            yield canvas
+
+    return gen(), (W, H)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--model", nargs=2, action="append", metavar=("TAG", "LABEL"), required=True)
+    ap.add_argument("--prompts", default="runs/eval/vbench_subset/prompts.txt")
+    ap.add_argument("--n_prompts", type=int, default=12)
+    ap.add_argument("--select_seed", type=int, default=0, help="RNG seed for choosing the prompts")
+    ap.add_argument("--seed", type=int, default=0, help="which of the 5 sample seeds the strips show")
+    a = ap.parse_args()
+    prompts = [l.rstrip("\n") for l in open(a.prompts) if l.strip()]
+    sel = sorted(random.Random(a.select_seed).sample(range(len(prompts)), a.n_prompts))
+    for sub in ("strips", "seeds"):
+        os.makedirs(os.path.join(a.out, sub), exist_ok=True)
+    lf, pf = ImageFont.truetype(FONT_B, 22), ImageFont.truetype(FONT, 18)
+    lf_s, pf_s = ImageFont.truetype(FONT_B, 16), ImageFont.truetype(FONT, 15)
+    vid = lambda tag, p, k: os.path.join("runs/eval", tag, "videos", f"{p}-{k}.mp4")
+    strips, mids = [], []
+    with open(os.path.join(a.out, "prompts.txt"), "w") as fp:
+        for n, i in enumerate(sel):
+            p = prompts[i]
+            fp.write(f"{n:02d}\t{i}\t{p}\n")
+            name = f"{n:02d}_" + re.sub(r"[^A-Za-z0-9]+", "_", p)[:60].strip("_")
+            # full-resolution strip, one seed
+            it, size = compose(a.model, [[vid(t, p, a.seed) for t, _ in a.model]], p, 832, 480, len(a.model), 1, lf, pf)
+            out = os.path.join(a.out, "strips", name + ".mp4")
+            buf = []
+
+            def keep(g):
+                for k, im in enumerate(g):
+                    if k == 40:
+                        buf.append(im.copy())
+                    yield im
+
+            write_video(out, keep(it), size)
+            strips.append(out)
+            mids.append(buf[0])
+            # seeds grid, half resolution
+            paths = [[vid(t, p, k) for t, _ in a.model] for k in range(5)]
+            it, size = compose(a.model, paths, p, 416, 240, len(a.model), 5, lf_s, pf_s,
+                               row_labels=[f"seed {k}" for k in range(5)])
+            write_video(os.path.join(a.out, "seeds", name + ".mp4"), it, size)
+            print(f"{n:02d} {p}", flush=True)
+
+    # all strips back to back (same frame size)
+    def all_frames():
+        for s in strips:
+            yield from frames(s, *mids[0].size)
+
+    write_video(os.path.join(a.out, "all_strips.mp4"), all_frames(), mids[0].size)
+    # overview: middle frame of every strip, scaled to half
+    w, h = mids[0].size[0] // 2, mids[0].size[1] // 2
+    ov = Image.new("RGB", (w, h * len(mids)), "black")
+    for k, m in enumerate(mids):
+        ov.paste(m.resize((w, h)), (0, k * h))
+    ov.save(os.path.join(a.out, "overview.jpg"), quality=85)
+    print("DONE", a.out)
+
+
+if __name__ == "__main__":
+    main()
